# Copy to .env; generate SECRET_KEY and POSTGRES_PASSWORD before Docker startup.
DEBUG=0
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,books.local
CSRF_TRUSTED_ORIGINS=https://localhost,https://books.local
SITE_URL=https://localhost
BEHIND_PROXY=1
DOMAIN=localhost
CADDY_CONFIG=Caddyfile.local
ACME_EMAIL=admin@example.com
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=books@example.com
TELEGRAM_BOT_TOKEN=
